# Production Environment Variables for Coolify
# Copy this file and fill in your production values

# Database - Use Coolify's managed PostgreSQL or your own
POSTGRES_USER=wrap
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=wrap
DATABASE_URL=postgresql://wrap:your_secure_password_here@postgres:5432/wrap

# Solana Network
SOLANA_NETWORK=mainnet
# or devnet for testing

# x402 Facilitator
X402_FACILITATOR_URL=https://x402.agentstrail.ai

# Platform Settings
PLATFORM_FEE_RATE=0.1

# Security - IMPORTANT: Generate secure random strings!
# Use: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_generate_secure_random
ENCRYPTION_SECRET=your_encryption_secret_here_generate_secure_random

# Ports (optional - defaults shown)
WEB_PORT=3000
API_PORT=3001
