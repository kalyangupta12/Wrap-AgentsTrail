# Database
DATABASE_URL="postgresql://user:password@localhost:5432/wrap?schema=public"

# Solana
NEXT_PUBLIC_SOLANA_NETWORK="devnet"

# x402 Facilitator
X402_FACILITATOR_URL="https://x402.agentstrail.ai"

# JWT
JWT_SECRET="your-secure-jwt-secret-change-in-prod"

# Redis (self-hosted on VPS)
REDIS_URL="redis://localhost:6379"

# Platform Settings
PLATFORM_FEE_RATE="0.1"

# Encryption Secret (for encrypting API keys in database)
# IMPORTANT: Generate a secure random string for production!
# e.g., openssl rand -base64 32
ENCRYPTION_SECRET="your-secure-encryption-secret-change-in-prod"
